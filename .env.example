# Copy this file to .env and fill in real values. Never commit the real .env.
#
# Rasa Pro Developer Edition license key — free, request at
# https://rasa.com/rasa-pro-developer-edition-license-key-request
# (Rasa reads this from the RASA_LICENSE env var specifically — not
# RASA_PRO_LICENSE, that name doesn't work.)
RASA_LICENSE=

# Only needed once your assistant calls an LLM (CALM flows, LLM-based
# NLU components, etc.) — not required for the Session 1 rule-based Hello World.
OPENAI_API_KEY=
# or, if the course standardizes on Anthropic instead:
# ANTHROPIC_API_KEY=
